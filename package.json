{
  "name": "fgo-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @fgo-lab/web dev",
    "build": "pnpm --filter @fgo-lab/web build",
    "preview": "pnpm --filter @fgo-lab/web preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps/web/src packages/*/src --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/test-runner.mjs compact",
    "test:unit": "node scripts/test-runner.mjs compact --suite=unit",
    "test:production": "node scripts/test-runner.mjs compact --suite=production",
    "test:agent": "node scripts/test-runner.mjs compact",
    "test:diagnostic": "node scripts/test-runner.mjs diagnostic",
    "test:runner": "node --test scripts/test-runner.test.mjs scripts/e2e-case-contract.test.mjs",
    "test:docs": "node --test scripts/docs-integrity.test.mjs && node scripts/docs-integrity.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/playwright-runner.mjs",
    "test:a11y": "node scripts/playwright-runner.mjs --grep @a11y",
    "validate:master": "pnpm --filter @fgo-lab/data-pipeline validate",
    "validate:evidence": "node scripts/test-runner.mjs compact --suite=production packages/calculation-application/src/evidenceInventory.test.ts packages/calculation-application/src/evidence.test.ts",
    "quality": "node scripts/quality-runner.mjs",
    "benchmark:calc": "vitest bench --run packages/calc-core/src/calc.bench.ts"
  },
  "dependencies": {
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.40.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
